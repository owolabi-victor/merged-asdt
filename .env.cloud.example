# ─────────────────────────────────────────────────────────────────────────────
# Hosted configuration. Copy to .env.cloud and fill in.
# Every value below has a localhost default in shared/config.py, so switching
# between local and hosted is purely a matter of which env file is loaded.
# ─────────────────────────────────────────────────────────────────────────────

# ── MQTT — HiveMQ Cloud (free serverless, no card) ───────────────────────────
#   https://console.hivemq.cloud  → Create cluster → Access Management
#   NOTE: HiveMQ Cloud is TLS-only on 8883. paho must use tls_set().
MQTT_BROKER=xxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=1

# ── Time series — InfluxDB Cloud Serverless (free, no card) ──────────────────
#   https://cloud2.influxdata.com  → Load Data → API Tokens
INFLUXDB_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=soil_telemetry

# ── Documents — MongoDB Atlas M0 (free, no card) ─────────────────────────────
#   https://cloud.mongodb.com  → Create free M0 → Network Access: 0.0.0.0/0
MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=asdt

# ── Cache — Redis Cloud free 30 MB (no card) ─────────────────────────────────
#   https://redis.io/try-free
REDIS_URL=redis://default:PASSWORD@redis-xxxxx.c1.eu-west-1-2.ec2.redns.redis-cloud.com:12345

# ── Knowledge graph — Neo4j AuraDB Free (no card) ────────────────────────────
#   https://console.neo4j.io  → New instance → AuraDB Free
#   Save the generated password: it is shown once.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── LLM — Ollama Cloud (already working) ─────────────────────────────────────
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_API_KEY=

# ── Not hosted ───────────────────────────────────────────────────────────────
# Eclipse Ditto has no free managed offering. service_layer/ditto_sync.py is
# skipped when DITTO_URL is unset, so the twin runs without it; the Thing
# representation is then local-only and should be described as such.
DITTO_URL=

# Physical layer: replay the captured ESP32 readings.
USE_REAL_SENSOR=1
REAL_SENSOR_CSV=data/soil_dataset.csv
REAL_SENSOR_INTERVAL=5
