# Local development configuration.
#
#   cp .env.example .env
#
# The ports below are the ones docker-compose.yml PUBLISHES, which are
# deliberately not the container-internal defaults: this stack is designed to
# run alongside a second twin, so every service is remapped to avoid a clash.
# The code's built-in fallbacks are the internal ports (1883, 8086, 27017,
# 6379), so without this file a fresh clone starts, connects to nothing, and
# reports no data rather than an error. Copy it before the first run.

# ── Identity ─────────────────────────────────────────────────────────────────
ASSET_ID=soil_parcel_001
ASSET_TYPE=soil_parcel
ACTIVE_SOIL_TYPE=loamy

# ── MQTT (mosquitto: 2883 -> 1883) ───────────────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=2883
MQTT_TLS=0
MQTT_USERNAME=
MQTT_PASSWORD=

# ── InfluxDB (9086 -> 8086) ──────────────────────────────────────────────────
INFLUXDB_URL=http://localhost:9086
INFLUXDB_TOKEN=my-super-secret-token
INFLUXDB_ORG=asdt
INFLUXDB_BUCKET=soil_telemetry

# ── MongoDB (28017 -> 27017) ─────────────────────────────────────────────────
MONGO_URI=mongodb://admin:password@localhost:28017
MONGO_DB=asdt

# ── Redis (7379 -> 6379) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:7379

# ── Eclipse Ditto (1080 -> 80) ───────────────────────────────────────────────
DITTO_URL=http://localhost:1080
DITTO_USER=ditto
DITTO_PASSWORD=ditto
DITTO_NAMESPACE=org.asdt

# ── MinIO (10000 -> 9000) ────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:10000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── API ──────────────────────────────────────────────────────────────────────
# Used by the Streamlit portals to reach the twin API (9500 -> 8080).
ASDT_API_URL=http://localhost:9500
JWT_SECRET=change-me-in-any-shared-deployment

# ── LLM (intelligent layer) ──────────────────────────────────────────────────
# Local Ollama by default. For hosted inference use https://ollama.com and set
# OLLAMA_API_KEY. The model must be pulled before the agent will answer.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=
